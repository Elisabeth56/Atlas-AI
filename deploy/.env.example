# Copy to deploy/.env on the VM. Never commit the real file.

# Caddy serves this name; point an A record at the VM's public IP first.
API_DOMAIN=api.atlas.example.com

# Supabase: Project Settings → Database → Connection string → "Session pooler" (IPv4, keeps prepared statements).
# Swap the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
AUTH_MODE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co

# The Vercel production URL, comma-separated if there are several; previews match the regex.
CORS_ORIGINS=https://atlas-ai-taupe.vercel.app
CORS_ORIGIN_REGEX=https://atlas-ai-[a-z0-9-]+-elisabeth-nnamanis-projects\.vercel\.app

# Real models (ADR 004). Any provider without a key is skipped.
DEMO_MODE=false
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

ENVIRONMENT=production
RUNS_PER_HOUR=10
