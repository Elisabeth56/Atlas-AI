# Copy to .env and fill in real values. Every var has a safe default that
# keeps the backend fully demoable with zero external services — see
# DEMO_MODE below.

# --- App ---
ENVIRONMENT=development

# When true, every agent runs against MockLLMProvider + MockDataHubGateway
# regardless of the credentials below. Set to false once you have a real
# Groq key and/or a running DataHub instance you want to exercise.
DEMO_MODE=true

# --- Auth ---
# "supabase" verifies Supabase access tokens; "off" puts every run in the demo workspace (local only).
AUTH_MODE=supabase
SUPABASE_URL=
# Only for legacy HS256 projects; current projects verify against SUPABASE_URL's JWKS.
SUPABASE_JWT_SECRET=
RUNS_PER_HOUR=10

# --- Database (Postgres, async via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
DB_ECHO=false

# --- LLM providers, tried in this order; leave a key blank to skip that provider ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- DataHub ---
# Point at your GMS instance once it's running, e.g. http://localhost:8080
# Leave blank to force MockDataHubGateway (fully demoable with no DataHub).
DATAHUB_GMS_URL=
DATAHUB_TOKEN=

# With DATAHUB_GMS_URL set, Atlas talks to DataHub through mcp-server-datahub
# (pip install mcp-server-datahub). Without it, the seeded sample catalog is used.

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
