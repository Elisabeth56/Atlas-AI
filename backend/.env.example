# Copy to .env and fill in real values. Every var has a safe default that
# keeps the backend fully demoable with zero external services — see
# DEMO_MODE below.

# --- App ---
ENVIRONMENT=development

# When true, every agent runs against MockLLMProvider + MockDataHubGateway
# regardless of the credentials below. Set to false once you have a real
# Groq key and/or a running DataHub instance you want to exercise.
DEMO_MODE=true

# --- Database (Postgres, async via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
DB_ECHO=false

# --- LLM: Groq (OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- DataHub ---
# Point at your GMS instance once it's running, e.g. http://localhost:8080
# Leave blank to force MockDataHubGateway (fully demoable with no DataHub).
DATAHUB_GMS_URL=
DATAHUB_TOKEN=

# How Atlas talks to DataHub when DATAHUB_GMS_URL is set:
#   "mcp"    — routes every read/write through mcp-server-datahub (default,
#              hackathon-relevant path; requires `pip install mcp-server-datahub`)
#   "direct" — falls back to raw GraphQL/REST (DataHubRestGateway)
# Ignored when DATAHUB_GMS_URL is empty — MockDataHubGateway is forced.
DATAHUB_ACCESS_MODE=mcp

# Pure UX framing for the frontend workspace setup — doesn't change which
# gateway class is used. One of: demo | existing | fresh.
DATAHUB_WORKSPACE_MODE=demo

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
